# CAILculator Auth Server Environment Variables

# Database (Railway sets this automatically in production)
DATABASE_URL=postgresql://localhost/cailculator_dev

# Server
PORT=8000
RAILWAY_PUBLIC_DOMAIN=localhost:8000

# Stripe (for payment processing)
STRIPE_SECRET_KEY=sk_test_...
# Optional: price IDs per plan. Unset = the live-mode IDs in main.py. Set all seven for test mode.
# STRIPE_PRICE_ID_INDIVIDUAL=price_...
# STRIPE_PRICE_ID_JOURNALIST=price_...
# STRIPE_PRICE_ID_ACADEMIC=price_...
# STRIPE_PRICE_ID_COMMERCIAL=price_...
# STRIPE_PRICE_ID_QUANT_EXPLORER=price_...
# STRIPE_PRICE_ID_QUANT_PROFESSIONAL=price_...
# STRIPE_PRICE_ID_QUANT_ELITE=price_...

# Admin endpoints (/admin/keys...): send as the X-Admin-Token header.
# Unset = admin endpoints disabled. Generate a long random value; keep it in a password manager.
ADMIN_TOKEN=

# SendGrid (for email verification)
SENDGRID_API_KEY=SG....
SENDGRID_FROM_EMAIL=iknowpi@gmail.com
